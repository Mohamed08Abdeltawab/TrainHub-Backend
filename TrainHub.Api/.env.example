# ==============================================================================
# TrainHub Backend - Production Environment Variables Template
# ==============================================================================
# In production, inject these environment variables via your container orchestrator,
# cloud platform (Azure App Service, AWS ECS, Google Cloud Run), or secrets manager.
#
# DO NOT COMMIT ACTUAL SECRET VALUES TO SOURCE CONTROL.
# ==============================================================================

# 1. ASP.NET Core Runtime Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=https://+:5087;http://+:5086

# 2. Database Connection String (SQL Server)
# Format: Server=<host>,<port>;Database=<name>;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;
ConnectionStrings__DefaultConnection=Server=tcp:your-db-server.database.windows.net,1433;Database=TrainingCenterSaasDb;User ID=your-db-user;Password=your-strong-production-password;Encrypt=True;TrustServerCertificate=False;

# 3. JWT Security Configuration
# Secret MUST be a secure, cryptographically random key of at least 32 characters (256 bits).
# NEVER use development dummy keys in production.
JwtSettings__Secret=Replace_With_Secure_Random_256_Bit_Key_Minimum_32_Characters_Long!
JwtSettings__Issuer=TrainHub
JwtSettings__Audience=TrainHubClient
JwtSettings__ExpiryMinutes=60
JwtSettings__RefreshTokenExpiryDays=7
JwtSettings__RequireHttpsMetadata=true

# 4. CORS Allowed Origins
# Specify the exact origins of your deployed frontend client applications.
Cors__AllowedOrigins__0=https://trainhub.yourdomain.com
Cors__AllowedOrigins__1=https://admin.trainhub.yourdomain.com

# 5. Logging Level
Logging__LogLevel__Default=Warning
Logging__LogLevel__Microsoft.AspNetCore=Warning
